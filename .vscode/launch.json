{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: AI Service",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/services/ai-service/src/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/services/ai-service",
      "python": "${workspaceFolder}/services/ai-service/venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/services/ai-service/src"
      }
    },
    {
      "name": "Node.js: Web Client",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/web-client/src/main.tsx",
      "cwd": "${workspaceFolder}/apps/web-client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "console": "integratedTerminal"
    },
    {
      "name": "Node.js: Auth Service",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/auth-service/src/index.ts",
      "cwd": "${workspaceFolder}/services/auth-service",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "console": "integratedTerminal"
    }
  ]
}
